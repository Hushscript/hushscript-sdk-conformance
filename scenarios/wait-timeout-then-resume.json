{
  "name": "wait-timeout-then-resume",
  "description": "The job stays in processing until mock clock 200. The first call times out after 60 s with a resume token; resume() then finishes.",
  "call": {
    "op": "resume",
    "args": { "file": "media/cbr-20s.mp3" },
    "prior": {
      "op": "transcribe",
      "args": { "file": "media/cbr-20s.mp3", "options": { "waitTimeout": 60 } },
      "expectError": { "class": "WaitTimeoutError", "fields": { "resumeToken": "<present>" } }
    }
  },
  "mock": {
    "account": { "balance_seconds": 36000 },
    "jobFlow": [{ "state": "processing", "untilClock": 200 }, { "state": "done" }]
  },
  "expect": {
    "result": { "id": "tr_conf_0001", "utteranceCount": 6 },
    "state": { "jobs": 1, "holds": 0 }
  }
}
