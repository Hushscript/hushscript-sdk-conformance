{
  "name": "page-null-part-urls",
  "description": "Twenty parts, sixteen URLs on the create page: the part-urls page that starts at 17 answers part_urls null, so parts 17 to 20 go through the API and complete succeeds.",
  "call": { "op": "transcribe", "args": { "file": "media/cbr-20s.mp3" } },
  "mock": { "account": { "balance_seconds": 36000 }, "upload": { "parts": 20, "nullPartUrls": "page" } },
  "expect": {
    "result": { "id": "tr_conf_0001", "utteranceCount": 6 },
    "requests": {
      "POST /v1/uploads": 1,
      "GET /v1/uploads/{job}/part-urls": 1,
      "PUT /__r2/{job}/{n}": 16,
      "PUT /v1/uploads/{job}/parts/{n}": 4,
      "POST /v1/uploads/{job}/complete": 1
    },
    "queries": { "GET /v1/uploads/{job}/part-urls": [{ "start": "17" }] },
    "authorization": { "PUT /v1/uploads/{job}/parts/{n}": "present" }
  }
}
