{
  "name": "create-null-part-urls",
  "description": "The create response has an upload object whose part_urls is null: direct is not available, so every part goes through the API with no part-urls page and no R2 PUT.",
  "call": { "op": "transcribe", "args": { "file": "media/cbr-20s.mp3" } },
  "mock": { "account": { "balance_seconds": 36000 }, "upload": { "parts": 3, "nullPartUrls": "create" } },
  "expect": {
    "result": { "id": "tr_conf_0001", "utteranceCount": 6 },
    "requests": {
      "POST /v1/uploads": 1,
      "GET /v1/uploads/{job}/part-urls": 0,
      "PUT /__r2/{job}/{n}": 0,
      "PUT /v1/uploads/{job}/parts/{n}": 3,
      "POST /v1/uploads/{job}/complete": 1
    },
    "authorization": { "PUT /v1/uploads/{job}/parts/{n}": "present" }
  }
}
